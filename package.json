{
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "format": "biome format --write ./docs ./.vitepress",
    "lint": "biome check --write ./docs ./.vitepress",
    "lint:eslint": "eslint ./docs ./.vitepress --fix",
    "lint:docs": "markdownlint ./docs && case-police 'docs/**/*.md' *.md",
    "lint:docs:fix": "markdownlint ./docs --fix && case-police 'docs/**/*.md' *.md --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@biomejs/biome": "2.2.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.6.2",
    "eslint": "^9.36.0",
    "eslint-plugin-case-police": "^2.0.0",
    "eslint-plugin-format": "^1.0.2",
    "markdownlint-cli": "^0.45.0",
    "vite": "^7.1.9",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.3.4",
    "vitepress-sidebar": "^1.33.0",
    "vue": "^3.5.22"
  }
}
